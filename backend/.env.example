# Environment Configuration
NODE_ENV=production
PORT=3000

# Database Connection (PostgreSQL with Prisma connection pooling)
DATABASE_URL="postgresql://hk_user:hk_password_secure_2026@localhost:5432/hk_connect_db?schema=public&connection_limit=20&pool_timeout=10"
# Direct connection for Prisma CLI / migrations (port 5432 on Supabase direct / bypass pooler)
DIRECT_URL="postgresql://hk_user:hk_password_secure_2026@localhost:5432/hk_connect_db?schema=public"

# JWT Authentication Secrets (min. 16 characters in production)
JWT_ACCESS_SECRET="hk_jwt_access_secret_super_key_2026_prod"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="hk_jwt_refresh_secret_super_key_2026_prod"
JWT_REFRESH_EXPIRES_IN="30d"

# Security & CORS (Comma-separated allowed origins or true for reflection)
CORS_ORIGIN="http://localhost:5173,https://app.hktransportes.com.br"

# Swagger Documentation (true/false)
ENABLE_SWAGGER="true"

# Integration API Keys (ERP / External Gateways)
ERP_API_KEY="hk_erp_integration_api_key_v1"
HK_ERP_API_URL="https://erp.hktransportes.com.br/api"

